{
    "id": "ubisoft",
    "name": "Ubisoft Connect",
    "version": "1.2.1",
    "min_core_version": "1.8.2",
    "platform": "ubisoft",
    "author": "RobbyRatpoison",
    "source": "github:RobbyRatpoison/playdate-plugin-ubisoft",
    "launcher": {
        "required": true,
        "name": "Ubisoft Connect",
        "exe_name": "UbisoftConnect.exe",
        "installer": {
            "url": "https://ubistatic3-a.akamaihd.net/orbit/launcher_installer/UbisoftConnectInstaller.exe",
            "type": "exe",
            "winearch": "win64",
            "win_version": "win10",
            "winetricks": ["d3dcompiler_43", "corefonts"],
            "post_install_files": [
                {
                    "path": "AppData\\Local\\Ubisoft Game Launcher\\settings.yaml",
                    "content": "overlay:\n  enabled: false\n  forceunhookgame: false\n  fps_enabled: false\n  warning_enabled: false\nuser:\n  closebehavior: CloseBehavior_Close"
                }
            ],
            "install_path": "Program Files (x86)\\Ubisoft\\Ubisoft Game Launcher",
            "detached_launcher": true
        }
    },
    "platform_status": {
        "windows": "untested",
        "linux": "working",
        "mac": "untested"
    }
}
